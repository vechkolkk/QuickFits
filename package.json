{
  "name": "quickfit",
  "version": "1.0.0",
  "private": true,
  "description": "QuickFit fitness and habit tracker full-stack app",
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File ./bootstrap.ps1",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm run dev --workspace client",
    "server:dev": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
